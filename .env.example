# Copy to a local .env that is never committed (this repo is public), or export these in your shell.
OPENAI_API_KEY=sk-your-own-key
SCHEDULER_MODEL=gpt-5-mini
SCHEDULER_REASONING_EFFORT=low
# 1 = scripted fake model: no API calls, no cost (the tests always use it)
SCHEDULER_FAKE_LLM=0
SCHEDULER_MAX_LLM_CALLS=40
